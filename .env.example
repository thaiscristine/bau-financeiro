MB_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Wiped by `npm run test:db` and `npm run test:e2e`, so the name must end in _test
TEST_DATABASE_URL=postgres://user:password@localhost:5433/lojinha_test

# Only used by `npm run seed` to create or update a login
SEED_NAME=Your Name
SEED_EMAIL=you@example.com
SEED_PASSWORD=pick-a-strong-password
